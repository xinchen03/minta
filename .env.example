# Minta Environment Variables
# Copy to .env and fill in your values

# ── Required ──
MINTA_DATABASE_URL=sqlite:///./minta.db
MINTA_JWT_SECRET=change-me-to-a-random-string
MINTA_API_KEY=minta_change_me_to_random_64_chars

# ── Optional ──
MINTA_ENV=development
MINTA_EXPERT_ENABLED=true
MINTA_AUTOPILOT_ENABLED=true

# Optional model/data overrides. Defaults use public model identifiers and
# repository-local ignored storage; never point public commits at user paths.
# MINTA_EXPERT_DATA_DIR=.minta-data/expert
# MINTA_CONFORMAL_DIR=.minta-data/conformal
# MINTA_CONFLICT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MINTA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Image captions are OFF by default. Choose local, api, or auto explicitly.
MINTA_IMAGE_CAPTION_BACKEND=off
# MINTA_IMAGE_CAPTION_API_KEY=
# MINTA_IMAGE_CAPTION_API_URL=https://api.openai.com/v1/chat/completions
# MINTA_IMAGE_CAPTION_MODEL=gpt-4o-mini

# ── SMTP (for email verification, optional for dev) ──
MINTA_SMTP_HOST=smtp.qq.com
MINTA_SMTP_PORT=465
MINTA_SMTP_USER=your-email@qq.com
MINTA_SMTP_PASS=your-smtp-password

# ── CORS (comma-separated origins) ──
MINTA_CORS_ORIGINS=http://localhost:8772

# ── Telemetry (anonymous heartbeat, default OFF) ──
# Sends only metadata: install id / version / OS / event name. Never content.
# Enable explicitly and provide your own event-send project key.
MINTA_TELEMETRY=0
# MINTA_TELEMETRY_POSTHOG_KEY=
